// Starlight's site title, with "DB" in the accent colour.
import { logos } from 'virtual:starlight/user-images';
const { siteTitleHref } = Astro.locals.starlightRoute;
const logo = logos.dark;
---

<a href={siteTitleHref} class="site-title sl-flex" aria-label="JsonDB home">
  {logo && <img alt="" src={logo.src} width={logo.width} height={logo.height} />}
  <span translate="no">Json<span class="db">DB</span></span>
</a>

<style>
  .site-title {
    align-items: center;
    gap: 0.6rem;
    font-size: var(--sl-text-h4);
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--sl-color-white);
    text-decoration: none;
    white-space: nowrap;
    min-width: 0;
  }
  .db {
    color: var(--sl-color-text-accent);
  }
  img {
    height: calc(var(--sl-nav-height) - 2 * var(--sl-nav-pad-y));
    width: auto;
  }
</style>
